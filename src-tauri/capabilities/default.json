{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "allow-canonicalize-pdf-path",
    "allow-read-pdf-file",
    "allow-canonicalize-epub-path",
    "allow-read-epub-file",
    "allow-load-reading-position",
    "allow-save-reading-position",
    "allow-load-epub-reading-position",
    "allow-save-epub-reading-position",
    "allow-create-epub-session",
    "allow-commit-epub-session",
    "allow-retire-epub-session",
    "allow-begin-epub-acquisition",
    "core:default",
    "core:window:allow-set-title",
    "opener:default",
    "dialog:allow-open"
  ]
}
